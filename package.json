{
  "name": "@vope/utils",
  "version": "1.4.13",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./types/index.d.ts",
  "typings": "./types/index.d.ts",
  "module": "./lib/index.js",
  "main": "./cjs/index.js",
  "scripts": {
    "start": "esbuild ./pre.ts --outfile=pre.cjs --format=cjs & node ./pre.cjs",
    "prebuild": "npm run start & esbuild ./build.ts --outfile=build.cjs --format=cjs",
    "build": "node ./build.cjs",
    "premocha": "node ./build.cjs --type=test",
    "mocha": "mocha __tests/**/*.js",
    "test": "npm run mocha",
    "prepublishOnly": "npm run build & npm run test"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.js"
    }
  },
  "author": "vope",
  "license": "ISC",
  "files": [
    "cjs",
    "lib",
    "types"
  ],
  "devDependencies": {
    "@babel/parser": "^7.23.4",
    "@babel/traverse": "^7.23.4",
    "@babel/types": "^7.23.4",
    "@types/babel__traverse": "^7.20.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.4.5",
    "esbuild": "^0.19.4",
    "glob": "^10.3.10",
    "iconv-lite": "^0.6.3",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.5",
    "tslib": "^2.6.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.9",
    "@vope/types": "^1.0.12",
    "csstype": "^3.1.3",
    "lodash-es": "^4.17.21"
  }
}
