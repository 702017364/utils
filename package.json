{
  "name": "@vope/utils",
  "version": "1.2.0",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./types/index.d.ts",
  "module": "./lib/index.js",
  "main": "./cjs/index.js",
  "scripts": {
    "build": "npm run cjs | npm run esm | npm run types",
    "cjs": "rimraf cjs & npx tsc -p ./tsconfig.cjs.json",
    "esm": "rimraf lib & npx tsc -p ./tsconfig.esm.json",
    "types": "rimraf types & npx tsc -p ./tsconfig.types.json & node ./__devs/type.cjs",
    "trove": "node ./__devs/trove.cjs",
    "trove:build": "npm run devs & npm run trove",
    "devs": "rimraf __devs & npx tsc -p ./tsconfig.devs.json",
    "test": "node ./__devs/test.cjs & mocha __tests/**/*.js",
    "test:build": "npm run devs & npm run trove & npm run test",
    "prepublishOnly": "npm run devs & npm run trove & npm run test & npm run build"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.js"
    }
  },
  "author": "vope",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/generator": "^7.22.9",
    "@babel/parser": "^7.22.7",
    "@babel/traverse": "^7.22.8",
    "@babel/types": "^7.22.5",
    "@rollup/plugin-alias": "^5.0.0",
    "@rollup/plugin-typescript": "^11.1.2",
    "@types/babel__generator": "^7.6.4",
    "@types/babel__traverse": "^7.20.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.5",
    "@vope/types": "^1.0.2",
    "iconv-lite": "^0.6.3",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.28.1",
    "tslib": "^2.6.1",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "axios": "^1.4.0"
  },
  "files": [
    "cjs",
    "lib",
    "types"
  ]
}
