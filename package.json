{
  "name": "@vope/utils",
  "version": "1.5.0",
  "description": "",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./types/index.d.ts",
  "typings": "./types/index.d.ts",
  "module": "./lib/index.js",
  "main": "./cjs/index.js",
  "scripts": {
    "start": "esbuild ./start.ts --outfile=start.cjs --format=cjs & node ./start.cjs",
    "poststart": "esbuild ./pre.ts --outfile=pre.cjs --format=cjs & node ./pre.cjs",
    "build": "npm run start & node ./build.cjs",
    "premocha": "node ./build.cjs --type=test",
    "mocha": "mocha __tests/**/*.js",
    "test": "npm run mocha",
    "prepublishOnly": "npm run build & npm run test",
    "debug": "npm run start & npm run premocha"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.js"
    }
  },
  "author": "vope",
  "license": "ISC",
  "sideEffects": [
    "lib/storage/offline.js",
    "src/storage/offline.ts"
  ],
  "files": [
    "cjs",
    "lib",
    "types"
  ],
  "devDependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/babel__traverse": "^7.20.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.13.5",
    "@types/sm-crypto": "^0.3.4",
    "esbuild": "^0.25.0",
    "glob": "^11.0.1",
    "iconv-lite": "^0.6.3",
    "mocha": "^10.2.0",
    "puppeteer": "^24.3.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@type-challenges/utils": "^0.1.1",
    "@types/lodash-es": "^4.17.12",
    "@vope/types": "^1.1.1",
    "csstype": "^3.1.3",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "sm-crypto": "^0.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  }
}
