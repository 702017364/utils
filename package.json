{
  "name": "@vope/utils",
  "version": "1.9.3",
  "description": "",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "scripts": {
    "start": "esbuild ./start.ts --outfile=start.cjs --format=cjs & node ./start.cjs",
    "poststart": "esbuild ./pre.ts --outfile=pre.cjs --format=cjs & node ./pre.cjs",
    "build": "npm run start & node ./build.cjs",
    "premocha": "node ./build.cjs --type=test",
    "mocha": "mocha __tests/**/*.js",
    "test": "npm run mocha",
    "prepublishOnly": "npm run build & npm run test",
    "debug": "npm run start & npm run premocha",
    "clean": "rimraf start.cjs pre.cjs build.cjs src/index.ts dist/ __tests/ __examples/ sub_storage/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./storage": {
      "types": "./sub_storage/offline.d.ts",
      "import": "./sub_storage/offline.js",
      "require": "./sub_storage/offline.cjs.js"
    }
  },
  "author": "vope",
  "license": "ISC",
  "files": [
    "dist",
    "sub_storage",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.3",
    "@types/sm-crypto": "^0.3.4",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "iconv-lite": "^0.7.2",
    "mocha": "^11.7.5",
    "puppeteer": "^24.43.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0"
  },
  "dependencies": {
    "@type-challenges/utils": "^0.1.1",
    "@types/lodash-es": "^4.17.12",
    "@vope/types": "^1.3.0",
    "csstype": "^3.2.3",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "sm-crypto": "^0.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/702017364/utils.git",
    "directory": "packages/utils"
  }
}
