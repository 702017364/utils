{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@vope/utils": [
        "./src/index.ts"
      ],
      "@vope/utils/storage": [
        "./src/storage/offline.ts"
      ],
      "@examples/*": [
        "./examples/*"
      ]
    },
    "types": [
      "@types/mocha",
      "@types/node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "examples/**/*.ts",
    "shims.env.d.ts"
  ]
}